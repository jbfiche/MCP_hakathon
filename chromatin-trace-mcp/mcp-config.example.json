{
  "mcpServers": {
    "chromatin-trace": {
      "command": "/ABSOLUTE/PATH/TO/chromatin-trace-mcp/.venv/bin/chromatin-trace-mcp",
      "env": {
        "CHROMATIN_TRACE_ECSV": "/absolute/path/to/trace.ecsv",
        "CHROMATIN_LOCALIZATION_ECSV": "/absolute/path/to/localizations.ecsv",
        "CHROMATIN_DATASETS_JSON": "/absolute/path/to/datasets.local.json",
        "CHROMATIN_TRACE_OUTPUT_DIR": "/absolute/path/to/mcp_outputs",
        "CHROMATIN_EXPERIMENT_ROOTS": "/absolute/path/to/authorized/experiments",
        "CHROMATIN_COLLECTION_OUTPUT_DIR": "/absolute/path/to/collection_outputs",
        "CHROMATIN_PEARSON_OUTPUT_DIR": "/absolute/path/to/pearson_outputs",
        "CHROMATIN_MERGE_OUTPUT_DIR": "/absolute/path/to/trace_merge_outputs",
        "CHROMATIN_LOCALIZATION_MERGE_OUTPUT_DIR": "/absolute/path/to/localization_merge_outputs",
        "CHROMATIN_MERGED_STATS_OUTPUT_DIR": "/absolute/path/to/merged_trace_statistics_outputs",
        "CHROMATIN_TRACE_ANALYZER_OUTPUT_DIR": "/absolute/path/to/trace_analyzer_outputs"
      }
    }
  }
}
